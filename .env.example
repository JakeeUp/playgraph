# Get a free Steam Web API key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Optional. Gaming headlines on the For You page, from https://apitube.io.
# Left empty, For You says news isn't set up yet.
APITUBE_API_KEY=

# Optional. PlayStation trophies and PS4/PS5 play time from public PSN profiles.
# Left empty, PlayStation linking is switched off. This is the NPSSO of ONE
# server-owned PSN account, never a user's. Use a dedicated PSN account rather
# than your main one: Sony's APIs here are unofficial and heavy use can get the
# signing-in account restricted. To get it: sign in at https://www.playstation.com
# with that account, then open https://ca.account.sony.com/api/v1/ssocookie in the
# same browser and copy the "npsso" value. It lasts about two months. Generating
# a new one invalidates the old one, so keep exactly one deployed copy.
PSN_NPSSO=
# Sony request pacing, per process (API and worker each get their own budget):
# at most PSN_REQUEST_BUDGET requests per PSN_BUDGET_WINDOW_SECONDS, and at
# least PSN_MIN_REQUEST_INTERVAL seconds between request starts.
# PSN_REQUEST_BUDGET=200
# PSN_BUDGET_WINDOW_SECONDS=900
# PSN_MIN_REQUEST_INTERVAL=0.5

# Optional. Game metadata, cover art and search from IGDB (https://api-docs.igdb.com).
# Left empty, IGDB is switched off. Register an application at
# https://dev.twitch.tv/console/apps (the Twitch account needs two-factor
# authentication), set its client type to Confidential, and copy its Client ID
# and a new Client Secret here. IGDB is free for non-commercial use; a
# commercial launch needs an IGDB partnership first (see PHASES.md).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Public URL this app is running at (needed for the Steam OpenID return_to)
APP_BASE_URL=http://localhost:8000

# Secret used to sign session/JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Local dev defaults to SQLite so there is no database server to install.
# The app detects the sqlite:// scheme and adjusts the connection args itself.
DATABASE_URL=sqlite:///./playgraph.db

# For a Postgres deployment instead, use a URL like the one below and also
# install requirements-postgres.txt:
# DATABASE_URL=postgresql://playgraph:playgraph@localhost:5432/playgraph

# Redis backs the arq job queue. Without Docker, a free hosted Redis
# (Upstash, Redis Cloud) works fine - paste its connection URL here.
REDIS_URL=redis://localhost:6379/0
# Production must set ENVIRONMENT=production and an HTTPS APP_BASE_URL.
# Production startup rejects plaintext Redis and Redis without a password.
ENVIRONMENT=development

# Container startup (python -m app.serve) requires this OS environment variable
# in production. Use verified proxy/checker peer IPs or narrow CIDRs, never '*'.
# A .env file does not configure Uvicorn's proxy trust. Local default: trust none.
# FORWARDED_ALLOW_IPS=

# Access tokens expire after this many minutes. Allowed range: 5 to 60.
SESSION_MINUTES=30
